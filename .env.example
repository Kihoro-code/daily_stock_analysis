# ===================================
# A-Share Watchlist Intelligent Analysis System - Environment Variable Configuration Template
# Copy this file to .env and fill in real configurations
# ===================================

# Watchlist (comma-separated, supports Shanghai and Shenzhen stock codes)
# Shanghai: 600xxx, 601xxx, 603xxx
# Shenzhen: 000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# Anspire Open API Keys (supports multiple, comma-separated)
# Get it at: https://open.anspire.cn/?share_code=QFBC0FYC
# When no higher-priority OpenAI-compatible source is configured, this key can be reused for Anspire LLM gateway and news search if conditions are met.
# The gateway and models below are example configurations for the current project; whether they are available depends on the Anspire console and official documentation:
# Example gateway: https://open-gateway.anspire.cn/v6
# Example model: Doubao-Seed-2.0-lite (can be overridden as ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro)
# If the gateway has regional/version differences, it can be overridden as ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true
# Data source configuration
# Tushare Pro Token (Optional, get from https://tushare.pro/weborder/#/login?reg=834638)
TUSHARE_TOKEN=
# TickFlow API Key (Optional, used for A-share market index enhancement; if plan supports stock pool query, it can also enhance market statistics)
# TICKFLOW_API_KEY=

# AlphaSift Stock Selection Integration (Disabled by default; usually maintained via the Web "Enable Stock Selection" button)
ALPHASIFT_ENABLED=false
# Switch instructions:
# - ALPHASIFT_ENABLED only affects the AlphaSift stock selection process, it will not overwrite/migrate/clean existing LITELLM_*/LLM_* configurations.
# - To disable/revert, simply set ALPHASIFT_ENABLED to false; existing provider/base_url/custom headers and fallback semantics remain exactly as they were.
# - Compatibility basis (Operations verification): LiteLLM providers and OpenAI-compatible semantic explanations are in the comments below; the runtime defaults to the pinned litellm version in requirements.txt.
ALPHASIFT_INSTALL_SPEC=git+https://github.com/ZhuLinsen/alphasift.git@14e74fc0819267f7c04c3117a0dd0fe3f9b19404
# Compatibility instructions:
# - ALPHASIFT_INSTALL_SPEC is only used for explicit /api/v1/alphasift/install calls; it will not automatically overwrite historical .env configurations.
# - After upgrading, if you want to use a new pin, please clear this variable from the old `.env` and rebuild dependencies/restart services; or change directly to 14e74fc... and rebuild the backend.
# - Changing only this field in .env without reverting `requirements.txt` and `src/config.py` will trigger an allow-list rejection (alphasift_install_spec_not_allowed).
# AlphaSift full market snapshot source priority; if not configured, DSA will automatically inject based on whether TUSHARE_TOKEN is configured:
# - With TUSHARE_TOKEN: tushare,sina,efinance,akshare_em,em_datacenter
# - Without TUSHARE_TOKEN: sina,efinance,akshare_em,em_datacenter
# SNAPSHOT_SOURCE_PRIORITY=tushare,sina,efinance,akshare_em,em_datacenter
# (If you want to keep consistent with runtime auto-injection, it's recommended to leave this blank and not fix the value in this file)
# The latest version of AlphaSift supports last-good snapshot, daily historical and industry/concept provider caching; DSA runtime defaults to the isolated cache directory under data/alphasift.
# To customize, overwrite the paths below; leaving them blank will not overwrite existing DSA configurations.
# ALPHASIFT_DATA_DIR=data/alphasift
# ALPHASIFT_FALLBACK_SNAPSHOT_PATH=data/alphasift/snapshot.last_good.json
# ALPHASIFT_DAILY_HISTORY_CACHE_DIR=data/alphasift/daily_history
# ALPHASIFT_INDUSTRY_PROVIDER_CACHE_DIR=data/alphasift/industry_provider_cache
# AlphaSift industry/concept provider is disabled by default; enabling akshare can provide more sector info for theme_heat, industry heat, and LLM context.
# INDUSTRY_PROVIDER=none
# INDUSTRY_PROVIDER_MAX_BOARDS=80
# Single LLM request timeout in seconds; AlphaSift stock selection will reuse this DSA configuration, downgrading to return non-LLM sorted results upon timeout.
# LLM_TIMEOUT_SEC=60

# Finnhub (Optional, US stock data source, free tier 60 calls/min)
# Get it at: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage (Optional, US stock data source, free tier 25 calls/day)
# Get it at: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI (Optional, fallback for US/HK stock volume ratio, turnover rate, PE, etc.)
# Get from https://open.longbridge.com/
# OAuth 2.0 (Recommended): First run scripts/generate_longbridge_oauth_token.py to generate local SDK token cache
# client_id takes precedence from LONGBRIDGE_OAUTH_CLIENT_ID; if empty and no Legacy Access Token, LONGBRIDGE_APP_KEY is used for compatibility
# GitHub Actions / Docker can place the base64 encoded token cache file into LONGBRIDGE_OAUTH_TOKEN_CACHE_B64
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API Key (Compatible with old accounts; Access Token is not OAuth access token)
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info in-process cache TTL in seconds, default 86400; 0=fetch on every request
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# Cooldown seconds after connection close exceptions, default 15; Longbridge is temporarily skipped during cooldown to avoid frequent connection retries at request level
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# Longbridge SDK language matches REPORT_LANGUAGE (zh/en); SDK logs written to LOG_DIR/longbridge_sdk.log
# Endpoint (unrelated to REPORT_LANGUAGE; leave blank to use defaults below):
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# Override endpoint; SDK internally uses LONGPORT_REGION (without BRIDGE) to auto-select,
# The code will automatically sync LONGBRIDGE_REGION -> LONGPORT_REGION.
# hk -> *.longbridge.com  |  cn -> *.longbridge.cn
# For more info: https://open.longbridge.com/en/docs/getting-started#environment-variables
# Overnight quote true/false, default false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# K-line push mode realtime or confirmed, default realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# Whether to print quote packages on connection (consistent with README / full-guide: when unset, defaults to off on the app side, equivalent to false)
# Set to 1 / true / yes to enable detailed SDK quote package logs (used for debugging Longbridge connections)
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# Remote update for stock auto-completion index (Enabled by default; auto-downgrades to local built-in index when GitHub is inaccessible)
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true

# ===================================
# AI Model Configuration
# ===================================
# Full documentation: docs/LLM_CONFIG_GUIDE.md
#
# [Quick Start] Just fill in one API Key to run, the system will auto-detect the model.
#   Anspire Open (All-in-one model+search) -> Fill ANSPIRE_API_KEYS
#   Gemini (Free tier) -> Fill GEMINI_API_KEY
#   DeepSeek (High cost-performance) -> Fill DEEPSEEK_API_KEY
#   AIHubmix (Aggregation platform) -> Fill AIHUBMIX_KEY
#
# [Advanced] Need multi-model / multi-platform fallback -> Configure "Multi-channel" below or manage visually in the Web settings page.
# ===================================

# --- API Key (Fill only one) ---

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
# Multi-Key Load Balancing: GEMINI_API_KEYS=key1,key2,key3

# DeepSeek (https://platform.deepseek.com)
# Compatibility default: When only DEEPSEEK_API_KEY is provided, deepseek-chat is still used, with a log prompt to migrate to deepseek-v4-flash
# DEEPSEEK_API_KEY=

# AIHubmix Aggregation (https://aihubmix.com/?aff=CfMq)
# One Key for GPT/Claude/Gemini/GLM/Qwen and other models, no VPN required
# AIHUBMIX_KEY=

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# OpenAI / Compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # Third-party API address (proxy/relay), leave blank for official

# Ollama Local Model (No API Key required, recommended)
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# Or use channel mode:
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b

# Sampling temperature (0.0-2.0, default 0.7; 0 is most deterministic, 2 is most random)
# Strict temperature compatibility sources:
# - Moonshot API / Model Docs: https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# - Moonshot Official Model Card (Eval default temperature = 1.0): https://huggingface.co/moonshotai/Kimi-K2.6
# - OpenAI Chat Completions Spec: https://platform.openai.com/docs/api-reference/chat/create
# - LiteLLM OpenAI-Compatible Spec: https://docs.litellm.ai/docs/providers/openai_compatible
# Current repository runtime dependency constraints: litellm>=1.80.10,!=1.82.7,!=1.82.8,<2.0.0 (explicitly excludes PyPI accident versions, see requirements.txt).
# Therefore kimi-k2.6 will automatically use 1.0/0.6; default temperature models like GPT-5 / o series will omit temperature to avoid API rejecting requests.
# If the compatible platform returns explicit parameter not supported errors, the runtime will modify the parameters and retry once within the current request; successful strategies are cached in-process only.
# For top_p, presence_penalty, frequency_penalty, seed, if "parameter not supported" is returned, it will likewise trigger request-level modification and retry (without changing LLM_TEMPERATURE).
# Other models and fallbacks will still use your configured LLM_TEMPERATURE.
# Web settings page / Desktop import will not silently clear or modify LLM_TEMPERATURE; parameters are temporarily adapted just before sending the actual request.
# If the main model switches back to a normal model, the original configured temperature is auto-restored; the minimal rollback is reverting this LLM parameter adaptation change.
# LLM_TEMPERATURE=0.7

# --- Multi-channel Configuration (Optional, can also be configured in Web settings page) ---
# Each channel configures base_url / api_key / models independently, supporting multi-Key polling and auto-fallback.
#
# Example: DeepSeek + Gemini dual channels
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview
#
# Example: Custom API Endpoint (Third-party proxy / Aggregation platform / Relay node)
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-5.5,claude-sonnet-4-6
# LLM_MY_PROXY_PROTOCOL=openai
#
# Example: Ollama Local Model (No API Key required)
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2
#
# Common Vendor Templates (Choose any to copy to .env; full instructions in docs/llm-providers.md)
#
# Anspire Open (Shared Search and LLM Key, OpenAI Compatible)
# LLM_CHANNELS=anspire
# LLM_ANSPIRE_PROTOCOL=openai
# LLM_ANSPIRE_BASE_URL=https://open-gateway.anspire.cn/v6
# LLM_ANSPIRE_API_KEY=sk-xxx
# LLM_ANSPIRE_MODELS=Doubao-Seed-2.0-lite,Doubao-Seed-2.0-pro
# LITELLM_MODEL=openai/Doubao-Seed-2.0-lite
#
# AIHubmix Aggregation Platform (OpenAI Compatible)
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_PROTOCOL=openai
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-xxx
# LLM_AIHUBMIX_MODELS=gpt-5.5,claude-sonnet-4-6,gemini-3.1-pro-preview
# LITELLM_MODEL=openai/gpt-5.5
#
# OpenAI Official
# LLM_CHANNELS=openai
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-xxx
# LLM_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
# LITELLM_MODEL=openai/gpt-5.5
#
# DeepSeek Official
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LITELLM_MODEL=deepseek/deepseek-v4-flash
#
# Gemini Official (Official protocol, Base URL left blank)
# LLM_CHANNELS=gemini
# LLM_GEMINI_PROTOCOL=gemini
# LLM_GEMINI_API_KEY=xxx
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
# LITELLM_MODEL=gemini/gemini-3.1-pro-preview
#
# Anthropic Claude Official (Official protocol, Base URL left blank)
# LLM_CHANNELS=anthropic
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7
# LITELLM_MODEL=anthropic/claude-sonnet-4-6
#
# Kimi / Moonshot (OpenAI Compatible)
# LLM_CHANNELS=moonshot
# LLM_MOONSHOT_PROTOCOL=openai
# LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MOONSHOT_MODELS=kimi-k2.6,kimi-k2.5
# LITELLM_MODEL=openai/kimi-k2.6
#
# Tongyi Qianwen DashScope (OpenAI Compatible)
# LLM_CHANNELS=dashscope
# LLM_DASHSCOPE_PROTOCOL=openai
# LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DASHSCOPE_API_KEY=sk-xxx
# LLM_DASHSCOPE_MODELS=qwen3.6-plus,qwen3.6-flash
# LITELLM_MODEL=openai/qwen3.6-plus
#
# Zhipu GLM (OpenAI Compatible)
# LLM_CHANNELS=zhipu
# LLM_ZHIPU_PROTOCOL=openai
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=xxx
# LLM_ZHIPU_MODELS=glm-5.1,glm-4.7-flash
# LITELLM_MODEL=openai/glm-5.1
#
# MiniMax (OpenAI Compatible)
# Source: Official OpenAI API compatibility doc https://platform.minimax.io/docs/api-reference/text-chat
# LiteLLM routes via openai/<model> to compatible Chat Completions Base URL.
# LLM_CHANNELS=minimax
# LLM_MINIMAX_PROTOCOL=openai
# LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MINIMAX_API_KEY=xxx
# LLM_MINIMAX_MODELS=MiniMax-M2.7,MiniMax-M2.7-highspeed
# LITELLM_MODEL=openai/MiniMax-M2.7
#
# Xiaomi MiMo (OpenAI Compatible)
# Please refer to MiMo official docs/console for Base URL and model names.
# LLM_CHANNELS=mimo
# LLM_MIMO_PROTOCOL=openai
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=sk-xxx
# LLM_MIMO_MODELS=mimo-xxx
# LITELLM_MODEL=openai/mimo-xxx
# Note: The repo's default daily_analysis workflow does not explicitly pass LLM_MIMO_* through. This example defaults to applying in local .env, Docker, or self-hosted scripts; for Actions usage, please synchronize the workflow mapping.
#
# Volcengine Ark / Doubao (OpenAI Compatible, adjust endpoint according to the actual region activated)
# Source: Volcengine Ark Online Inference / Responses API Doc https://www.volcengine.com/docs/82379/2121998
# LiteLLM routes via openai/<model> to compatible Chat Completions Base URL.
# LLM_CHANNELS=volcengine
# LLM_VOLCENGINE_PROTOCOL=openai
# LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_VOLCENGINE_API_KEY=xxx
# LLM_VOLCENGINE_MODELS=doubao-seed-1-6-251015,doubao-seed-1-6-thinking-251015
# LITELLM_MODEL=openai/doubao-seed-1-6-251015
#
# SiliconFlow (OpenAI Compatible)
# Source: Official Model List https://docs.siliconflow.cn/quickstart/models
# LLM_CHANNELS=siliconflow
# LLM_SILICONFLOW_PROTOCOL=openai
# LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_SILICONFLOW_API_KEY=sk-xxx
# LLM_SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3-235B-A22B-Thinking-2507
# LITELLM_MODEL=openai/deepseek-ai/DeepSeek-V3.2
#
# OpenRouter (OpenAI Compatible)
# Source: Official Models API https://openrouter.ai/docs/api/api-reference/models/get-models
# LLM_CHANNELS=openrouter
# LLM_OPENROUTER_PROTOCOL=openai
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_MODELS=~anthropic/claude-sonnet-latest,~openai/gpt-latest
# LITELLM_MODEL=openai/~anthropic/claude-sonnet-latest

# Advanced: Model routing YAML configuration (Optional, reference docs/examples/litellm_config.example.yaml)
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# Search Engine Configuration (for obtaining stock news)
# ===================================
# Bocha API Keys (Chinese search optimized, supports AI summaries, supports multiple, comma-separated)
# Get at: https://open.bocha.cn/
# BOCHA_API_KEYS=your_bocha_key_here
# MiniMax API Key (Coding Plan Web Search, supports multiple, comma-separated)
# Get at: https://platform.minimax.io/
# MINIMAX_API_KEYS=your_minimax_key_here
# Tavily API Keys (supports multiple, comma-separated)
TAVILY_API_KEYS=
# SerpAPI Keys (supports multiple, comma-separated)
SERPAPI_API_KEYS=
# Brave Search API Keys (supports multiple, comma-separated)
# Get at: https://brave.com/search/api/
BRAVE_API_KEYS=
# SearXNG Instance URLs (comma-separated, private deployments have no quotas, requires format: json enabled in settings.yml)
# GitHub Actions daily analysis workflow supports Variables fallback to Secrets for the same name; public URLs can be configured as a Variable.
# If left blank, defaults to pulling public instances automatically from searx.space; if you don't want to access public instances, set the switch below to false
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=true

# ===================================
# Social Sentiment Intelligence (US stocks only)
# ===================================
# Reddit / X (Twitter) / Polymarket sentiment data from api.adanos.org
# Only activates for US stock tickers (AAPL, TSLA, etc.), ignored for A-shares/HK stocks
# Free tier: 250 requests/month | Register: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# News Timeliness and Analysis Filtering Configuration
# ===================================
# News strategy window tiers: ultra_short (1 day) / short (3 days) / medium (7 days) / long (30 days)
# Actual window = min(Strategy window, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# News max age (days), restricts search results to the recent period to avoid using outdated information
# NEWS_MAX_AGE_DAYS=3
# Bias ratio threshold (%), prompts not to chase highs if deviation from MA5 exceeds this value; strong trend stocks are automatically relaxed to 1.5 times
# BIAS_THRESHOLD=5.0

# ===================================
# Agent Strategy Dialogue Configuration (Web Dialogue Page)
# ===================================
# Enable Agent strategy dialogue (Default false, internally named as skill uniformly)
# AGENT_MODE=true
# Agent Main Model (Optional): Inherits main model if blank; without provider prefix, it parses as openai/<model>
# AGENT_LITELLM_MODEL=
# Agent max inference steps limit (When default 10, child Agents run with their own presets; when higher than default 10, all child Agents unify to this value; when lower than a child Agent's default, it caps as the upper limit)
# AGENT_MAX_STEPS=10
# Default enabled strategies (comma-separated), uses the built-in defaults below if not configured
#
# Built-in strategy skills list (can be combined arbitrarily):
#   bull_trend          — Bull trend (MA5>MA10>MA20 arrangement + low bias ratio)
#   ma_golden_cross     — MA golden cross (MA5 crosses above MA10/MA20)
#   volume_breakout     — Volume breakout (Price breaks recent highs + volume amplifies)
#   hot_theme           — Hot themes (Policy/industry hot spots, sector diffusion and stock correlation)
#   event_driven        — Event driven (Catalyst events like earnings, policies, orders, M&A)
#   growth_quality      — Growth quality (Revenue/profit, ROE, cash flow and growth sustainability)
#   expectation_repricing — Expectation repricing (Earnings/policy/valuation expectation gap repair or failure)
#   shrink_pullback     — Shrink pullback (Pullback to MA + volume shrinks, low buy point)
#   bottom_volume       — Bottom volume (Lowest volume sees lowest price, bottom reversal signal)
#   dragon_head         — Dragon head strategy (Strong sector leaders, trend continuation chasing)
#   one_yang_three_yin  — One Yang Three Yin (Strong engulfing pattern after main force shakeout)
#   box_oscillation     — Box oscillation (Range bound sell high buy low)
#   chan_theory          — Chan theory (Zen in the Markets theory: stroke/line segment/pivot)
#   wave_theory         — Wave theory (Elliott wave counting)
#   emotion_cycle       — Emotion cycle (Market emotion high and low point rotation)
#
# When left blank, system uses the main default strategy skill declared in metadata (built-in default is bull_trend)
# AGENT_SKILLS=
#
# You can also manually specify a set of strategies:
# AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
#
# Fully enable all built-in strategies (both notations are equivalent):
# AGENT_SKILLS=all
# AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,hot_theme,event_driven,growth_quality,expectation_repricing,shrink_pullback,bottom_volume,dragon_head,one_yang_three_yin,box_oscillation,chan_theory,wave_theory,emotion_cycle
#
# AGENT_SKILLS=
# Custom strategy directory (Optional, place custom YAML strategy files; env variable names follow internal skill naming)
# AGENT_SKILL_DIR=./strategies

# Agent Architecture Mode (default single; multi is multi-Agent orchestration mode)
# AGENT_ARCH=single

# Multi-Agent Orchestration Mode (Effective only when AGENT_ARCH=multi)
# quick: Technical analysis -> Decision (Fastest, ~2 LLM calls)
# standard: Technical -> Intelligence -> Decision (Default)
# full: Technical -> Intelligence -> Risk Control -> Decision
# specialist: Technical -> Intelligence -> Risk Control -> Strategy Expert Evaluation -> Decision
# AGENT_ORCHESTRATOR_MODE=standard

# Agent execution timeout budget (seconds, 0 means disabled; single-agent uses as overall loop budget, multi-agent uses as orchestration budget; default 600)
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# Whether Risk Control Agent can veto buy signals (Default enabled)
# AGENT_RISK_OVERRIDE=true

# Memory and calibration system (Tracks historical accuracy, auto-adjusts confidence)
# AGENT_MEMORY_ENABLED=false

# Automatically weight strategy opinions based on backtest performance
# AGENT_SKILL_AUTOWEIGHT=true

# Strategy routing mode (auto=Automatically select based on market status / manual=Use AGENT_SKILLS list)
# AGENT_SKILL_ROUTING=auto

# Stock inquiry visible dialogue context compression (Default disabled). When enabled, only compresses user-visible user/assistant history, without affecting tool/thinking passthrough in the same turn.
# AGENT_CONTEXT_COMPRESSION_ENABLED=false
# Compression profile: cost=Saves more tokens / balanced=Balanced / long_context_raw_first=Prioritizes keeping more raw text
# AGENT_CONTEXT_COMPRESSION_PROFILE=balanced
# Historical token threshold triggering compression; if blank, follows current profile preset
# AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=
# When compressing, keep raw text for recent N user turns and subsequent replies; if blank, follows current profile preset
# AGENT_CONTEXT_PROTECTED_TURNS=

# Event alert monitoring (schedule mode background polling; reuses configured notification channels upon trigger)
# Compatibility note: This section only adds alert rule configs and will not modify model name, provider, Base URL, LiteLLM or LLM configuration semantics; to rollback simply disable/remove event monitor configs.
# legacy JSON only supports three types of single-symbol basic rules; for technical indicators, watchlists, positions/accounts, and market traffic light rules, please use the Web/API Alert Center to configure.
# legacy JSON supported rules:
#   price_cross          — Price breaches threshold, direction: above / below, field: price
#   price_change_percent — Rise/fall percentage threshold, direction: up / down, field: change_pct (unit: %)
#   volume_spike         — Volume amplifies, field: multiplier (relative to 20-day average volume multiplier)
# AGENT_EVENT_MONITOR_ENABLED=false
# AGENT_EVENT_MONITOR_INTERVAL_MINUTES=5
# AGENT_EVENT_ALERT_RULES_JSON=[{"stock_code":"600519","alert_type":"price_cross","direction":"above","price":1800},{"stock_code":"300750","alert_type":"price_change_percent","direction":"down","change_pct":3.0},{"stock_code":"000858","alert_type":"volume_spike","multiplier":2.5}]

# ===================================
# Notification Channel Configuration (Multiple can be configured simultaneously, all will be pushed to)
# ===================================
#
# [Method 1] WeCom Robot
# In WeCom Group -> Settings -> Group Robot -> Add -> Copy Webhook URL
#
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
#
# [Method 2] Feishu Robot (Choose one of two)
#
# Method 2a — Group Custom Robot Webhook
# In Feishu Group -> Settings -> Group Robot -> Add Robot -> Custom Robot -> Copy Webhook URL
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_key_here
# If robot security settings enabled "Signature Verification", you must synchronously fill in secret
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# If robot security settings enabled "Keyword", you must fill in the same keyword; the system will automatically prepend it to each message
# FEISHU_WEBHOOK_KEYWORD=StockDailyReport
#
# Method 2b — Feishu App Bot Push
# Create an app in the Feishu Open Platform, enable im:message permission and publish.
#
# Group Chat Mode (Recommended): Invite robot to the target group, get chat_id from group settings
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
#
# Private Chat Mode: Direct message a specific user. User's open_id is obtained from robot events or contacts API.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=ou_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=open_id
# FEISHU_DOMAIN=feishu  # Domain: feishu(Domestic Feishu) / lark(International larksuite.com)
#
# [Method 3] Telegram Robot (Both must be configured simultaneously)
# 1. Find @BotFather in Telegram -> /newbot -> Get Bot Token
# 2. Get Chat ID: Message @userinfobot or visit https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# [Method 4] Email Push (Only 2 configurations required, SMTP auto-detected)
# Supports QQ Mail, 163 Mail, Gmail and other emails supporting SMTP authorization code/basic auth
# If Outlook / Exchange tenant forces OAuth2, currently not supported in this version
# 1. Get auth code (Example QQ Mail): Settings -> Account -> POP3/SMTP Service -> Enable -> Get Auth Code
# 2. Fill in the two items below:
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # Optional, leave blank to send to yourself
#
# [Method 4 Extension] Send stock groups to different emails (Issue #268, Optional)
# STOCK_LIST determines the actual analysis scope; STOCK_GROUP_N only determines who the email is sent to, it's recommended to always make it a subset of STOCK_LIST
# Telegram / WeCom / Webhook and other channels will still push according to the full STOCK_LIST, and will not split due to grouping
# Current repo default GitHub Actions daily_analysis workflow will not auto-inject arbitrary numbered STOCK_GROUP_N / EMAIL_GROUP_N
# Thus this capability is suitable for local .env, Docker, or other runtime environments that have explicitly injected these variables
# STOCK_GROUP_1=600519,300750
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=002594,AAPL
# EMAIL_GROUP_2=user2@example.com
#
# [Method 5] Custom Webhook (Supports multiple, comma-separated)
# Suitable for: DingTalk, Discord, Slack, Bark, Self-hosted services, or any Webhook supporting POST JSON
# System will auto-detect common services and use corresponding formats
#
# CUSTOM_WEBHOOK_URLS=https://oapi.dingtalk.com/robot/send?access_token=xxx,https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # Optional, for Webhooks requiring auth (Header Authorization: ******
# CUSTOM_WEBHOOK_BODY_TEMPLATE=  # Optional, global JSON body template, will overwrite Bark/Slack/Discord auto payloads; recommend $content_json/$title_json
# WEBHOOK_VERIFY_SSL=true   # Default verifies; affects webhook-style HTTPS notification requests reading this config. Set to false to support self-signed certs. Warning: Disabling risks MITM hijacking, use only in trusted intanets
#
# [Method 6] Pushover Configuration
# Register Pushover account, and create App Token https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# [Method 6 Extension] ntfy Configuration
# NTFY_URL must include topic path, e.g., https://ntfy.sh/my-topic or https://self-hosted:port/my-topic
# System will parse the topic and use ntfy JSON publish API to send Markdown text.
# NTFY_URL=
# NTFY_TOKEN=  # Optional, for topics requiring ****** or self-hosted ntfy server
#
# [Method 6 Extension] Gotify Configuration
# GOTIFY_URL is Gotify server base URL, without /message; system will append /message and send token using X-Gotify-Key Header.
# GOTIFY_URL=
# GOTIFY_TOKEN=  # Gotify application token
#
# [Method 7] PushPlus Configuration (Domestic push service, recommended)
# Register PushPlus account and get Token https://www.pushplus.plus
# PUSHPLUS_TOKEN=
# Group push: After filling group code, message is pushed to all subscribed users of the group (One-to-many)
# PUSHPLUS_TOPIC=
#
# [Method 8] Discord Configuration
# Supports two methods: Webhook (Recommended, simple config) and Bot API (High permissions)
# 
# Method 1: Discord Webhook (Recommended, no Bot account required)
# In Discord channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 
# Method 2: Discord Bot API (Requires Bot account and channel ID)
# 1. Create Bot: https://discord.com/developers/applications -> New Application -> Bot -> Add Bot
# 2. Get Bot Token: Bot page -> Reset Token
# 3. Get Channel ID: Enable Discord Developer Mode -> Right click channel -> Copy ID
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # Compatible with old variable name, recommend switching to DISCORD_MAIN_CHANNEL_ID
# If you want to receive Discord Interaction / Webhook callbacks, you must configure public key for signature verification
# Get it at: Discord Developer Portal -> General Information -> Public Key
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# 
# [Method 9] Slack Configuration
# Supports two methods: Bot API (Recommended) and Incoming Webhook
# When both configured, Bot API is prioritized to ensure text and images are sent to the same channel.
#
# Method 1: Slack Bot API (Recommended, supports image upload)
# 1. Create Slack App: https://api.slack.com/apps -> Create New App
# 2. Add Bot Token Scopes: chat:write, files:write
# 3. Install to Workspace and get Bot Token (xoxb-...)
# 4. Get Channel ID: Channel details -> Copy Channel ID at bottom
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# Method 2: Slack Incoming Webhook (Simple config, does not support image upload)
# In Slack App management page create Incoming Webhook -> Copy URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# [Method 10] ServerChan 3 Configuration (Domestic push service, supports WeChat push)
# Register ServerChan 3 account and get SendKey https://sc3.ft07.com/
# SERVERCHAN3_SENDKEY=
#
# [Method 11] AstrBot Configuration
# ASTRBOT_URL=
# ASTRBOT_TOKEN=  # Optional, for AstrBot Webhook requiring ******
#
# [Advanced Configuration] Message length limits (Bytes)
# Exceeding limit will auto-split into batches, generally no need to modify
# FEISHU_MAX_BYTES=20000    # Feishu limit approx 20KB, default 20000 bytes
# WECHAT_MAX_BYTES=4000     # WeCom limit 4096 bytes, default 4000 bytes
#
# [Markdown to Image] (Issue #455)
# For channels not supporting Markdown, send report converted to image to improve readability
# Single stock push + Image: Must configure MARKDOWN_TO_IMAGE_CHANNELS and install image conversion tool simultaneously
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,wechat,custom,email,slack   # Comma-separated
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # Will not convert if length exceeds this, avoiding oversized images
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage(Default) | markdown-to-file(emoji handles better, needs npm i -g markdown-to-file)
# Image conversion tool: wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf), or markdown-to-file
#
# [Notification Routing Strategy] (Issue #1200 P3)
# Leave blank by default: Notification of this type is sent to all configured channels. Fill in to only send to the listed configured channels.
# Allowed values: wechat,feishu,telegram,email,pushover,ntfy,gotify,pushplus,serverchan3,custom,discord,slack,astrbot
# NOTIFICATION_REPORT_CHANNELS=
# NOTIFICATION_ALERT_CHANNELS=
# NOTIFICATION_SYSTEM_ERROR_CHANNELS=
#
# [Notification Noise Reduction Mechanism] (Issue #1200 P4)
# Default all disabled; only affects static notification channels, does not affect robot triggered session receipts.
# NOTIFICATION_DEDUP_TTL_SECONDS=0      # Same stable deduplication key is only sent once within TTL; 0 disables
# NOTIFICATION_COOLDOWN_SECONDS=0       # Rate limits same cooldown key within window; 0 disables
# NOTIFICATION_QUIET_HOURS=             # Quiet hours, format HH:MM-HH:MM, supports crossing midnight
# NOTIFICATION_TIMEZONE=                # Quiet hours timezone, e.g. Asia/Shanghai; leave blank to follow TZ/system local timezone
# NOTIFICATION_MIN_SEVERITY=            # info,warning,error,critical; leave blank to keep status quo
# NOTIFICATION_DAILY_DIGEST_ENABLED=false  # Reserved config; currently does not send daily digest
#
# [Realtime Quote Prefetch] (Issue #455)
# PREFETCH_REALTIME_QUOTES=true   # Set to false to disable, avoiding efinance/akshare_em full market pull; tushare is a single stock interface, prefetch only pulls the first stock

# ===================================
# Single Stock Push Configuration (Optional)
# ===================================
# Single stock push mode: Push immediately after analyzing each stock, instead of pushing after summarization
# SINGLE_STOCK_NOTIFY=false
#
# Report type: simple, full, brief (3-5 sentences summary)
# Under Docker environment if push content is incomplete, it can be set to full
# REPORT_TYPE=simple
# Report output language: zh (Chinese, default) / en (English)
# REPORT_LANGUAGE=zh
# Only analysis result summary: When set to true only pushes summary, without individual stock details
# REPORT_SUMMARY_ONLY=false
# Notify report bottom displays the LLM model name used for this analysis; set to false to hide
# REPORT_SHOW_LLM_MODEL=true
#
# Report Engine P0 (Jinja2 / Integrity check / Historical comparison)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# Merge individual stock analysis and broad market review pushes (Default false), reducing email quantity, lowering spam email risk
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# Analysis Interval Configuration (Optional)
# ===================================
# Delay time between individual stock analysis and broad market analysis (Seconds)
# Used to avoid triggering AI API rate limits like Gemini
# ANALYSIS_DELAY=0

# App AppKey (Shared with Webhook mode)
DINGTALK_APP_KEY=xxxx
# App AppSecret (Shared with Webhook mode)
DINGTALK_APP_SECRET=xxxx
# Enable Stream mode
DINGTALK_STREAM_ENABLED=false

# Feishu App Configuration (Used for App Bot proactive push / Stream Bot / Cloud doc; will not directly enable group Webhook push)
FEISHU_APP_ID=xxxx
FEISHU_APP_SECRET=xxxx  # App Bot proactive push also requires FEISHU_CHAT_ID; simple group push prioritizes using FEISHU_WEBHOOK_URL
# App Bot proactive push target; Stream Bot or Cloud doc do not need this
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
# Enable persistent connection mode
FEISHU_STREAM_ENABLED=false
# Feishu Group Robot Webhook Security Configuration (Used only for Webhook push mode)
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# FEISHU_WEBHOOK_KEYWORD=StockDailyReport

# Database Path
DATABASE_PATH=./data/stock_analysis.db
# SQLite Write Optimization: File DB defaults to WAL enabled, lowering lock competition during batch writes and concurrent write-backs
SQLITE_WAL_ENABLED=true
# SQLite busy wait timeout (milliseconds)
SQLITE_BUSY_TIMEOUT_MS=5000
# Max retry count when SQLite encounters database is locked / database table is locked
SQLITE_WRITE_RETRY_MAX=3
# SQLite write retry base backoff time (seconds, increases with exponential backoff)
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# Analysis History Snapshot: Set to false to not persist the full context_snapshot
# Includes enhanced_context, market_phase_summary, AnalysisContextPack overview, diagnostics, and raw snapshot fields
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# Backtest Configuration (Optional)
# ===================================
# Whether to enable backtesting (true/false)
# BACKTEST_ENABLED=true
# Backtest evaluation window (Trading days)
# BACKTEST_EVAL_WINDOW_DAYS=10
# Only backtest analysis records from N days ago (avoiding incomplete data from today/recently)
# BACKTEST_MIN_AGE_DAYS=14
# Backtest engine version (used to distinguish results when backtest logic upgrades)
# BACKTEST_ENGINE_VERSION=v1
# Neutral band threshold (%), e.g., 2 means -2%~+2% is considered oscillating
# BACKTEST_NEUTRAL_BAND_PCT=2.0

# === Scheduled Task Configuration ===
# Whether to enable scheduled tasks (true/false)
SCHEDULE_ENABLED=false
# Daily execution time (HH:MM format, 24-hour system)
SCHEDULE_TIME=18:00
# Whether to run analysis immediately once when schedule mode starts (true/false)
# If not explicitly set, schedule mode will follow RUN_IMMEDIATELY runtime override semantics to maintain compatibility with old configs
SCHEDULE_RUN_IMMEDIATELY=true
# Whether to run analysis immediately once when non-schedule mode starts (true/false)
RUN_IMMEDIATELY=true
# Whether to enable broad market review (true/false)
MARKET_REVIEW_ENABLED=true
# Whether to inject broad market context summary into individual stock analysis Prompt and enable conservative guardrails (true/false, default enabled)
DAILY_MARKET_CONTEXT_ENABLED=true
# Broad market review market region: cn (A-shares), hk (HK stocks), us (US stocks), both (All markets), hk/us suitable for users only focusing on HK/US stocks
# MARKET_REVIEW_REGION=cn
# Broad market review index rise/fall colors: green_up = green rise red fall (default), red_up = red rise green fall
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# Proxy Configuration (Optional)
# ===================================
# Whether to enable proxy (true/false, default false)
# Only effective in local development environments, auto-skipped in GitHub Actions environment
USE_PROXY=false
# Proxy Server Address (Default 127.0.0.1)
PROXY_HOST=127.0.0.1
# Proxy Server Port (Default 10809)
PROXY_PORT=10809

# System Configuration
# Log Directory
LOG_DIR=./logs
# Log Level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# LiteLLM Internal Log Level (DEBUG/INFO/WARNING/ERROR/CRITICAL; default WARNING; can be temporarily set to DEBUG when troubleshooting internal streaming/routing details)
# LITELLM_LOG_LEVEL=WARNING
# Max concurrent worker threads (Recommend keeping low concurrency to prevent bans)
MAX_WORKERS=3
# Whether to enable debug logs
DEBUG=false

# ===================================
# WebUI Configuration (Optional)
# ===================================
# Whether to start WebUI by default (true/false, default false)
WEBUI_ENABLED=false
# WebUI listening address (Default 127.0.0.1; Docker/Cloud servers must be set to 0.0.0.0 for external access, see docs/deploy-webui-cloud.md)
WEBUI_HOST=127.0.0.1
# WebUI listening port (Default 8000)
WEBUI_PORT=8000
# Whether to auto build frontend before starting Web service (npm install && npm run build, default true)
WEBUI_AUTO_BUILD=true
# Under single-tier trusted reverse proxy (e.g., Nginx -> App) trust X-Forwarded-For to get real IP, taking the rightmost value for login rate limiting; in multi-tier proxy/CDN scenarios, rate limit key may degrade to edge proxy IP, requiring extra evaluation; keep false when directly connecting to public internet to prevent spoofing
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web Login Authentication (Optional)
# ===================================
# Set to true to enable password protection; set initial password on webpage during first access, can be modified in "System Settings > Change Password"
# Forgotten passwords can be reset by executing on server: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Session Validity (Hours)

# ===========================================
# Recognize Stock Codes from Images (Settings Page "Add from Image")
# ===========================================
# Single request timeout 60 seconds; Image max 5MB
# Requires configuring at least one of GEMINI_API_KEY, ANTHROPIC_API_KEY, or OPENAI_API_KEY (Vision capability models)

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# Lower number = higher priority (tried first)
# Default priorities: efinance(0) > akshare(1) > tushare/pytdx(2) > baostock(3) > yfinance(4)
# For US stocks, set YFINANCE_PRIORITY=0 to use Yahoo Finance first

# EFINANCE_PRIORITY=0      # EastMoney (China) - default: 0
# EFINANCE_CALL_TIMEOUT=30 # Timeout (seconds) for efinance API calls; prevents indefinite hangs
#                          # when eastmoney hosts are unreachable. Default: 30
# AKSHARE_PRIORITY=1       # AkShare (China) - default: 1
# TUSHARE_PRIORITY=2       # Tushare Pro (China) - default: 2
# PYTDX_PRIORITY=2         # Tongdaxin (China) - default: 2
#
# Pytdx custom server (for intranet/deploy): use custom host instead of built-in public servers
# PYTDX_HOST=192.168.1.100
# PYTDX_PORT=7709
# Or multiple servers: PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3      # Baostock (China) - default: 3
# YFINANCE_PRIORITY=4      # Yahoo Finance (Global) - default: 4

# Example: Prioritize Yahoo Finance for US stocks
# YFINANCE_PRIORITY=0
# EFINANCE_PRIORITY=99

# ===========================================
# Realtime Quote Data Source Priority Configuration
# ===========================================
# Used to obtain volume ratio, turnover rate, PE ratio and other realtime data
# Available data sources (comma-separated, tried in order):
#   - tencent: Tencent Finance, has volume ratio/turnover rate/PE/PB, single stock query is stable (recommended first choice)
#   - akshare_sina: Sina Finance, basic quote, no volume ratio, but very stable
#   - efinance: EastMoney (efinance lib), has volume ratio, full dump easily banned
#   - akshare_em: EastMoney (akshare lib), most comprehensive data, full dump easily banned
#   - tushare: Tushare Pro, requires 2000 points, comprehensive data (recommended for paid users)
#
# Default priority: tencent > akshare_sina > efinance > akshare_em
# If you have a high-point Tushare Pro account, you can place tushare first:
# REALTIME_SOURCE_PRIORITY=tushare,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# Whether to enable realtime quotes (When disabled, historical close prices are used for analysis)
# ENABLE_REALTIME_QUOTE=true

# Intraday realtime technicals: When enabled, uses realtime price to calculate MA/bullish arrangements (Issue #234); when disabled, uses yesterday's close
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# Whether to enable chip distribution (This interface is unstable, recommended to disable for cloud deployments)
# ENABLE_CHIP_DISTRIBUTION=true

# Whether to enable fundamental aggregation (New P0 capability)
# ENABLE_FUNDAMENTAL_PIPELINE=true

# Fundamental aggregation performance and stability parameters (Unit: Seconds)
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=3.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Portfolio P0: Import / Risk / FX Downgrade Configuration
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
# PORTFOLIO_FX_UPDATE_ENABLED=true

# EastMoney Interface Patch: Recommended to enable when EastMoney/Efinance/Akshare EastMoney interfaces frequently fail (RemoteDisconnected, Connection closed)
# When enabled, injects NID tokens and random User-Agents, lowering the probability of being rate-limited by EastMoney
# ENABLE_EASTMONEY_PATCH=false
